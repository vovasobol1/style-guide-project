// Настройки markdownlint. Каждое отличие от правил по умолчанию связано с разделом
// «Markdown» руководства (docs/rules/markdown.md).
{
  "config": {
    "default": true,
    // MD-02: заголовки только через #
    "MD003": { "style": "atx" },
    // MD-03: маркер списка — дефис
    "MD004": { "style": "dash" },
    // MD-03: вложенные списки с отступом 4 пробела, как требует Python-Markdown
    "MD007": { "indent": 4 },
    // Длину строки не ограничиваем: один абзац — одна строка
    "MD013": false,
    // Одинаковые подзаголовки допустимы в разных разделах страницы
    "MD024": { "siblings_only": true },
    // MD-03: нумерация 1, 2, 3
    "MD029": { "style": "ordered" },
    // Якоря вида {#ton-01} проверяет сборка mkdocs build --strict
    "MD051": false,
    // MD-04: блоки кода только ограждающие, через обратные апострофы
    "MD046": { "style": "fenced" },
    "MD048": { "style": "backtick" },
    // FMT-05: полужирный через звездочки
    "MD050": { "style": "asterisk" }
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules/**", "site/**", ".venv/**"]
}
